# Copy to .env and fill in. .env is gitignored.
# OpenRouter key (LA hub $250 compute credit). https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Estimated spend threshold in USD; actual charges may exceed reservations.
# Use a provider-side key limit if you require a strict spending constraint.
OPENROUTER_BUDGET_USD=250
# Optional: shown on openrouter.ai activity page.
OPENROUTER_APP_NAME=swarm-composition
# Optional: sent as HTTP-Referer to OpenRouter (attribution only).
# OPENROUTER_REFERER=
# Optional: Adaption platform key (sponsor credits). Not read by the harness;
# only for your own scripts using the `adaption` SDK.
# ADAPTION_API_KEY=
